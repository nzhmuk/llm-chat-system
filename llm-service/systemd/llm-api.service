[Unit]
Description=LLM FastAPI Service
After=network.target ollama.service

[Service]
Type=simple

# IMPORTANT: use your real user (root or ubuntu, etc.)
User=root
Group=root

# Working directory
WorkingDirectory=/opt/llm-service/api

# Start app (run.sh activates venv)
ExecStart=/usr/bin/env bash /opt/llm-service/api/run.sh

# Restart policy
Restart=always
RestartSec=3

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=OLLAMA_URL=http://127.0.0.1:11434
Environment=OLLAMA_MODEL=deepseek-r1:7b

# Logs go to journalctl
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target