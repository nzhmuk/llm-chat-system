OLLAMA_URL=http://127.0.0.1:11434

# Model used for generation (must be pulled in Ollama).
OLLAMA_MODEL=qwen2.5:3b

# "-1" keeps the model loaded in memory indefinitely (no cold starts).
# Use a duration like "30m" to unload after idle and save RAM.
OLLAMA_KEEP_ALIVE=-1

# Max tokens per response. Caps length/latency; set -1 for unlimited.
OLLAMA_NUM_PREDICT=200

# Reasoning toggle for hybrid models (e.g. qwen3): "false" disables the slow
# <think> chain-of-thought. Leave EMPTY for non-thinking models like qwen2.5
# (sending the flag to a model that lacks thinking can error).
OLLAMA_THINK=

# Required: API key clients must present as "Authorization: Bearer <key>".
# The installer generates this automatically; set it manually for local runs.
LLM_API_KEY=
